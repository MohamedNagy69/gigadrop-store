# ============================================================
# GIGADROP — Production Environment Variables (.env.example)
# ============================================================

# 1. MySQL Database Connection URL (PlanetScale / Railway / TiDB / VPS MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/gigadrop"

# 2. NextAuth Configuration
# Generate a strong secret using: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-32-char-production-secret"
NEXTAUTH_URL="https://your-domain.com"

# 3. Storefront Public Settings
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_STORE_WHATSAPP="201012345678"
